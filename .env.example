# --- App ---
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# --- Storage ---
DUCK_PATH=./data/casefile.duckdb

# --- Limits ---
INGEST_CHUNK_ROWS=50000
MAX_MEMORY_GB=6

# --- LLM (optional, only for /report) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-change-me
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- Neo4j (optional) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

