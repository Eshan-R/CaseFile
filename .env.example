# --- App ---
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# --- Storage ---
DUCK_PATH=./data/casefile.duckdb

# --- Limits ---
INGEST_CHUNK_ROWS=50000
MAX_MEMORY_GB=6

# --- LLM (Google Gemini with automatic offline template fallback) ---
LLM_GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_CALL_BUDGET=20
LLM_TIMEOUT_SECONDS=30.0
LLM_THINKING_EFFORT=low
LLM_PREGEN_DELAY_SECONDS=1.0

# --- Neo4j (optional) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
